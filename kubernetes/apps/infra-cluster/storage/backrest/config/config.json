{
  "version": 5,
  "instance": "infra-cluster",
  "repos": [
    {
      "id": "nas",
      "uri": "/backups/infra-cluster/backrest/repository",
      "autoInitialize": true,
      "autoUnlock": false,
      "checkPolicy": {
        "schedule": {
          "cron": "0 4 * * 0",
          "clock": "CLOCK_UTC"
        },
        "readDataSubsetPercent": 100
      },
      "prunePolicy": {
        "schedule": {
          "cron": "30 4 * * 0",
          "clock": "CLOCK_UTC"
        },
        "maxUnusedPercent": 10
      }
    }
  ],
  "plans": [
    {
      "id": "litellm-db",
      "repo": "nas",
      "paths": ["/state/exports/litellm-db.tar"],
      "schedule": {
        "cron": "55 0,6,12,18 * * *",
        "clock": "CLOCK_UTC"
      },
      "retention": {
        "policyTimeBucketed": {
          "hourly": 24,
          "daily": 14,
          "weekly": 8,
          "monthly": 12
        }
      },
      "hooks": [
        {
          "conditions": ["CONDITION_SNAPSHOT_START"],
          "onError": "ON_ERROR_FATAL",
          "actionCommand": {
            "command": "test -f /state/exports/litellm-db.tar && test -n \"$(find /state/exports/litellm-db.tar -mmin -480 -print)\""
          }
        }
      ]
    },
    {
      "id": "backrest-config",
      "repo": "nas",
      "paths": ["/state/config.json"],
      "schedule": {
        "cron": "10 1 * * *",
        "clock": "CLOCK_UTC"
      },
      "retention": {
        "policyTimeBucketed": {
          "hourly": 24,
          "daily": 14,
          "weekly": 8,
          "monthly": 12
        }
      }
    },
    {
      "id": "app-technitium-0",
      "repo": "nas",
      "paths": ["/backups/infra-cluster/exports/technitium-0/current"],
      "schedule": {
        "cron": "30 2 * * *",
        "clock": "CLOCK_UTC"
      },
      "retention": {
        "policyTimeBucketed": {
          "daily": 14,
          "weekly": 8,
          "monthly": 6
        }
      },
      "hooks": [
        {
          "conditions": ["CONDITION_SNAPSHOT_START"],
          "onError": "ON_ERROR_FATAL",
          "actionCommand": {
            "command": "test -f /backups/infra-cluster/exports/technitium-0/current/.captured-at && test -n \"$(find /backups/infra-cluster/exports/technitium-0/current/.captured-at -mmin -1560 -print)\""
          }
        }
      ]
    },
    {
      "id": "app-technitium-1",
      "repo": "nas",
      "paths": ["/backups/infra-cluster/exports/technitium-1/current"],
      "schedule": {
        "cron": "35 2 * * *",
        "clock": "CLOCK_UTC"
      },
      "retention": {
        "policyTimeBucketed": {
          "daily": 14,
          "weekly": 8,
          "monthly": 6
        }
      },
      "hooks": [
        {
          "conditions": ["CONDITION_SNAPSHOT_START"],
          "onError": "ON_ERROR_FATAL",
          "actionCommand": {
            "command": "test -f /backups/infra-cluster/exports/technitium-1/current/.captured-at && test -n \"$(find /backups/infra-cluster/exports/technitium-1/current/.captured-at -mmin -1560 -print)\""
          }
        }
      ]
    },
    {
      "id": "app-pulse",
      "repo": "nas",
      "paths": ["/backups/infra-cluster/exports/pulse/current"],
      "schedule": {
        "cron": "40 2 * * *",
        "clock": "CLOCK_UTC"
      },
      "retention": {
        "policyTimeBucketed": {
          "daily": 14,
          "weekly": 8,
          "monthly": 6
        }
      },
      "hooks": [
        {
          "conditions": ["CONDITION_SNAPSHOT_START"],
          "onError": "ON_ERROR_FATAL",
          "actionCommand": {
            "command": "test -f /backups/infra-cluster/exports/pulse/current/.captured-at && test -n \"$(find /backups/infra-cluster/exports/pulse/current/.captured-at -mmin -1560 -print)\""
          }
        }
      ]
    },
    {
      "id": "app-autokuma",
      "repo": "nas",
      "paths": ["/backups/infra-cluster/exports/autokuma/current"],
      "schedule": {
        "cron": "45 2 * * *",
        "clock": "CLOCK_UTC"
      },
      "retention": {
        "policyTimeBucketed": {
          "daily": 14,
          "weekly": 8,
          "monthly": 6
        }
      },
      "hooks": [
        {
          "conditions": ["CONDITION_SNAPSHOT_START"],
          "onError": "ON_ERROR_FATAL",
          "actionCommand": {
            "command": "test -f /backups/infra-cluster/exports/autokuma/current/.captured-at && test -n \"$(find /backups/infra-cluster/exports/autokuma/current/.captured-at -mmin -1560 -print)\""
          }
        }
      ]
    }
  ]
}
