{
  "immich-db": {
    "kind": "postgres",
    "cluster": "app-cluster",
    "namespace": "media",
    "profile": "critical-6h",
    "selector": "app.kubernetes.io/instance=immich,app.kubernetes.io/controller=database",
    "container": "app",
    "database": "immich",
    "backup_password": "IMMICH_BACKUP_PASSWORD",
    "recovery_secrets": ["immich-secrets"],
    "login_roles": [
      {
        "user": "postgres",
        "secret": "immich-secrets",
        "password_key": "IMMICH_DB_PASSWORD"
      }
    ]
  },
  "litellm-db": {
    "kind": "postgres",
    "cluster": "infra-cluster",
    "namespace": "ai",
    "profile": "critical-6h",
    "selector": "app.kubernetes.io/instance=litellm-postgres,app.kubernetes.io/name=postgres",
    "container": "postgres",
    "database_secret": {
      "name": "litellm-postgres",
      "key": "LITELLM_POSTGRES_DB"
    },
    "backup_password": "LITELLM_BACKUP_PASSWORD",
    "recovery_secrets": ["litellm-postgres", "litellm-secrets"],
    "login_roles": [
      {
        "secret": "litellm-postgres",
        "user_key": "LITELLM_POSTGRES_USER",
        "password_key": "LITELLM_POSTGRES_PASSWORD"
      }
    ]
  }
}
